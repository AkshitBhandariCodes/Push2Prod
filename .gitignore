# Dependency directories (Jo har package aur root me local dependencies hold karte hain)
node_modules/
jspm_packages/
web_modules/
dev-docs/

# Build outputs (TypeScript compile hone ke baad ya NextJS build hone ke baad jo folders bante hain)
dist/
build/
.next/
out/
.turbo/

# Package managers specific logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variable files (Inme secure credentials hote hain, inhe Git pe nahi bhejna chahiye)
.env.development.local
.env.test.local
.env.production.local

# Operating System files
.DS_Store
Thumbs.db

# Project-specific ignores
design.md
DESIGN-vercel.md
design-vercel.md
config.bat

# Vercel-Pro local temporary builds directory
.vercel-pro-builds/

# Kubernetes secrets file — kabhi bhi git mein commit mat karo!
# Isme base64 encoded credentials hain
infra/k8s/secrets.yaml

# Temporary scratch directories
scratch/
scratch_clone/

# Reports and Documentation
Report/
docs/
implementation_plan.md
walkthrough.md
system_design_aws.md

# Log files
*.log
ts_error.log

# Temporary test / fix scripts (root directory)
fix.js
check_s3.js
*.sql
rename.ps1
