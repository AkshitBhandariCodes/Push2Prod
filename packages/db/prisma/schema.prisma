// Push2Prod ka PostgreSQL database schema
// Ye file project ki structural neenv (database tables) define karti hai

datasource db {
  provider = "postgresql"
  // dotenv package root level se connection string pick karega
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// --- ENUMS (Postgres native enum types banenge db migrations me) ---

// Project ka operational status â€” project abhi active hai, inactive hai, ya deploy ho raha hai
enum ProjectStatus {
  ACTIVE
  INACTIVE
  DEPLOYING
}

// Har deploy request ki workflow state â€” QUEUED se lekar READY ya ERROR tak
enum DeploymentStatus {
  QUEUED
  PENDING
  BUILDING
  READY
  ERROR
  CANCELLED
}

// Build progress timeline events ke types â€” jaise start, info, warning, error, end
enum BuildEventStatus {
  START
  INFO
  WARNING
  ERROR
  END
}

// --- MODELS ---

// User: Developer account â€” holds basic user info (email, name)
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Relations: Ek developer ke paas multiple projects ho sakte hain
  projects  Project[]
  accounts  Account[]
  sessions  Session[]
}

// NextAuth Required Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Project: App settings â€” name, slug (URL-friendly identifier), repo link, build config
model Project {
  id            String          @id @default(uuid())
  name          String          // Display name â€” "My Portfolio Site"
  slug          String          @unique // URL-friendly identifier â€” "my-portfolio-site"
  repositoryUrl String?         // Git repository URL (optional, user baad mein bhi add kar sakta hai)
  branch        String          @default("main") // Git branch to deploy from
  buildCommand  String          @default("npm run build") // Build command jo container mein chalegi
  outputDir     String          @default("dist") // Build ka output directory (e.g. dist, .next, build)
  rootDir       String          @default(".") // Repo ke andar project ka root directory
  status        ProjectStatus   @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments   Deployment[]
  envVars       ProjectEnvVar[]
}

// Deployment: Har build request ki full detail store karega (commit, build status, time)
model Deployment {
  id            String           @id @default(uuid())
  commitHash    String?
  commitMessage String?
  status        DeploymentStatus @default(QUEUED)
  
  // Phase 5: Worker Reliability fields
  attemptCount  Int              @default(0)
  lockedBy      String?          // Worker ID processing this deployment
  lockedUntil   DateTime?        // Time until lock expires
  lastError     String?          // Log of the last error if failed
  
  // Phase 8: Object Storage fields
  artifactBucket      String?
  artifactPrefix      String?   // Base S3 prefix for all uploaded files (e.g. deployments/<id>)
  serveDir            String?   // Relative sub-path within artifactPrefix where index.html lives
                                // e.g. '' (root), 'public', 'out' â€” auto-detected by build-runner
  uploadedFilesCount  Int?
  artifactUploadedAt  DateTime?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildLogs     BuildLog[]
  buildEvents   BuildEvent[]
}

// ProjectEnvVar: Environment configurations storing keys and values securely
model ProjectEnvVar {
  id        String   @id @default(uuid())
  key       String
  value     String
  createdAt DateTime @default(now())

  // Relations
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Composite constraint: Ek project me duplicate env variables allow nahi karenge
  @@unique([projectId, key])
}

// BuildLog: Docker container builds ke raw console text dumps (stdout/stderr lines)
model BuildLog {
  id           String     @id @default(uuid())
  message      String
  createdAt    DateTime   @default(now())

  // Relations
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

// BuildEvent: Structural updates (timeline logs) jaise "Cloned", "Docker built"
model BuildEvent {
  id           String           @id @default(uuid())
  type         BuildEventStatus @default(INFO)
  message      String
  createdAt    DateTime         @default(now())

  // Relations
  deploymentId String
  deployment   Deployment       @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}
