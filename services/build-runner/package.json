{
  "name": "@push2prod/build-runner",
  "version": "1.0.0",
  "description": "Isolated build runner \u00e2\u20ac\u201d untrusted code is executed inside this service only",
  "main": "dist/runner.js",
  "scripts": {
    "build": "node init && tsc",
    "start": "node init && node dist/runner.js",
    "dev": "node init && ts-node-dev --respawn --transpile-only src/runner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@push2prod/config": "workspace:*",
    "@push2prod/db": "workspace:*",
    "@push2prod/logger": "workspace:*",
    "mime-types": "^2.1.35",
    "simple-git": "^3.19.1"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
