# ==============================================================================
# Vercel-Pro: Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual values.
# DO NOT commit the '.env' file containing real secrets to Git.

# 1. Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vercel_pro"

# 2. Cache & Message Queue
REDIS_URL="redis://localhost:6380"

# 3. Microservice Ports
PROJECT_SERVICE_PORT=4001
API_GATEWAY_PORT=4000
ROUTING_SERVICE_PORT=4002

# 4. Object Storage (MinIO or AWS S3)
# For local dev with MinIO:
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="push2prod-builds"
S3_FORCE_PATH_STYLE="true"

# For Real AWS S3:
# S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
# S3_REGION="ap-south-1"
# S3_ACCESS_KEY="your-aws-access-key-id"
# S3_SECRET_KEY="your-aws-secret-access-key"
# S3_BUCKET_NAME="your-real-s3-bucket-name"
# S3_FORCE_PATH_STYLE="false"

# 5. NextAuth & GitHub OAuth Credentials
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"
AUTH_SECRET="your-nextauth-secret-key-32-chars"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
